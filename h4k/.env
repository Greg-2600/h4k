# Local compose overrides (gitignored).
# auditless owns 127.0.0.1:8080; BloodHound is published on 8081.
BH_PORT=8081
# Inside the h4k-net bridge, h4k reaches BloodHound by service name.
H4K_BLOODHOUND_URL=http://bloodhound:8080
# iotlab's HTTP facade is moved off 8080 to avoid the auditless collision.
IOT_HTTP_PORT=8082
